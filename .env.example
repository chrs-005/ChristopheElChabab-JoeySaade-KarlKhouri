# Copy values into your local shell or a private .env loader. Never commit secrets.
DATABASE_PATH=joey.db
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SERVICE_AUTH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8003
# Karl Khouri's audit logging service (port 8007). Its key must differ from SERVICE_AUTH_SECRET.
AUDIT_SERVICE_URL=http://127.0.0.1:8007
AUDIT_SERVICE_AUTH_SECRET=replace-with-a-third-random-secret-of-at-least-32-characters
# Karl Khouri's reports read these list APIs with the caller's token. Update when an owner changes port or prefix.
ASSET_REPORT_SOURCE=http://127.0.0.1:8002/api/Joey-Saade/assets
THREAT_REPORT_SOURCE=http://127.0.0.1:8004/api/Christophe-ElChabab/threats
VULNERABILITY_REPORT_SOURCE=http://127.0.0.1:8005/api/Christophe-ElChabab/vulnerabilities
INCIDENT_REPORT_SOURCE=http://127.0.0.1:8006/api/Christophe-ElChabab/incidents
AUDIT_REPORT_SOURCE=http://127.0.0.1:8007/api/Karl-Khouri/logs
REPORT_UPSTREAM_TIMEOUT=5
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DEPARTMENT=
