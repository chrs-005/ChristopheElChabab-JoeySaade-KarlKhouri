{
  "info": {
    "name": "Sprint I \u2014 Karl Khouri services",
    "description": "Security Audit Logging, Security Playbook and Response Automation, and Security Reports by Karl Khouri. Log in first; use an administrator token for most requests and an analyst token to update assigned actions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup \u2014 Karl Khouri",
      "item": [
        {
          "name": "Login (users service)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userUrl}}/api/Joey-Saade/users/login",
            "description": "Karl Khouri \u2014 Login (users service). Run against your own backend and inspect the actual response.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username_or_email\": \"{{username}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Authenticated', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.environment.set('token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Security Audit Logging \u2014 Karl Khouri",
      "item": [
        {
          "name": "Create log as service",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Service-Key",
                "value": "{{auditServiceKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{auditUrl}}/api/Karl-Khouri/logs",
            "description": "Karl Khouri \u2014 Create log as service. Run against your own backend and inspect the actual response.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{eventId}}\",\n  \"actor_user_id\": null,\n  \"actor_label\": \"unknown_user\",\n  \"action\": \"login_failed\",\n  \"description\": \"Failed login attempt\",\n  \"severity\": \"Warning\",\n  \"related_service\": \"users\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Stored or deduplicated', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "if (pm.response.code < 300) pm.environment.set('logId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
