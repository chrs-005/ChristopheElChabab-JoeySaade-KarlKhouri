  "item": [
    {
      "name": "Users and Identity — Joey Saade",
      "item": [
        {
          "name": "Register employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userUrl}}/api/Joey-Saade/users/register",
            "description": "Joey Saade — Register employee. Run folders in order and inspect the actual response.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Example Employee\",\n  \"username\": \"{{employeeUsername}}\",\n  \"email\": \"{{employeeEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"department\": \"IT\",\n  \"role\": \"Regular Employee\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString(36) + Math.random().toString(36).slice(2, 8);",
                  "pm.environment.set('employeeUsername', 'joey_employee_' + suffix);",
                  "pm.environment.set('employeeEmail', 'joey_employee_' + suffix + '@example.test');",
                  "pm.environment.set('eventId', 'joey-event-' + suffix);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "pm.test('No hash in response', () => pm.expect(pm.response.json()).to.not.have.property('password_hash'));",
                  "if (pm.response.code === 201) pm.environment.set('userId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userUrl}}/api/Joey-Saade/users/login",
            "description": "Joey Saade — Login. Run folders in order and inspect the actual response.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username_or_email\": \"{{username}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Authenticated', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.environment.set('token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
