    {
      "name": "Users and Identity \u2014 Joey Saade",
      "item": [
        {
          "name": "Register employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userUrl}}/api/Joey-Saade/users/register",
            "description": "Joey Saade \u2014 Register employee. Replace variables and inspect the actual response.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Example Employee\",\n  \"username\": \"example_employee\",\n  \"email\": \"example@example.test\",\n  \"password\": \"{{userPassword}}\",\n  \"department\": \"IT\",\n  \"role\": \"Regular Employee\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "pm.test('No hash in response', () => pm.expect(pm.response.json()).to.not.have.property('password_hash'));",
                  "if (pm.response.code === 201) pm.environment.set('userId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
